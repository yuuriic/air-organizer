{
  "name": "air-organizer",
  "version": "0.1.0",
  "description": "Aplicativo desktop local e supervisionado (Electron) para leitura somente leitura de pastas no AIR, com inventários locais selados, diagnóstico estrutural e propostas de revisão não executáveis.",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "app": "node scripts/run-desktop.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "electron": "45.2.2",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
