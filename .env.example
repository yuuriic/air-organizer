# Apenas parâmetros NÃO sensíveis. Nunca coloque senha, cookie ou token aqui.
# O .env real é ignorado pelo Git; os valores são lidos de variáveis de ambiente.

# URL inicial da instância AIR (só HTTPS, sem credenciais; query string e fragmento são descartados).
# O argumento --url tem precedência. Use um domínio real só no seu ambiente local, nunca em arquivos versionados.
# AIR_ORGANIZER_URL=https://air.exemplo.test/air/

# Diretório do perfil Chrome dedicado (fora do repositório).
# Padrão: %LOCALAPPDATA%\air-organizer\chrome-profile
# AIR_ORGANIZER_PROFILE_DIR=

# Limite de páginas por análise (proteção contra loops).
# AIR_ORGANIZER_MAX_PAGES=500

# Tempo máximo (ms) para leitura/troca de página.
# AIR_ORGANIZER_PAGE_TIMEOUT_MS=15000

# 1 = exibe o texto completo dos erros no console. Pode conter nomes de pastas, caminhos e URLs;
# use só para depuração local e não compartilhe a saída.
# AIR_ORGANIZER_VERBOSE_ERRORS=1
